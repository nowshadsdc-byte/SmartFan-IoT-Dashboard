# Copy to .env and fill in. NEVER commit .env.

# SQLite file. Inside Docker compose this is set automatically to file:/app/data/dev.db.
# For local (non-Docker) development use a path on your machine, e.g. file:./db/custom.db
DATABASE_URL=file:./db/custom.db

# Shared secret the ESP8266 sends as ?token=... (>= 16 chars). Generate: openssl rand -hex 24
DEVICE_TOKEN=change-me-device-token-0123456789

# Secret between Caddy/Next.js and the hub (>= 16 chars). Generate: openssl rand -hex 24
HUB_INTERNAL_SECRET=change-me-hub-secret-0123456789

# How the Next.js server reaches the hub (compose value: http://iot-hub:3003).
IOT_HUB_URL=http://localhost:3003

# Dashboard Basic Auth. Hash: docker run --rm caddy:2-alpine caddy hash-password
# IMPORTANT: keep the hash in SINGLE quotes so docker compose does not expand its $ characters.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH='$2a$14$replace.with.output.of.caddy.hash-password.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# Optional: days to keep sensor readings (default 30)
# READING_RETENTION_DAYS=30
